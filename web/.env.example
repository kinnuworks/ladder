# Ladder web: copy to .env.local for local runs, or set these in the Vercel project.

# ErrandFactory and Errand implementation on Base mainnet (from contracts/script/Deploy.s.sol output).
FACTORY_ADDRESS=
IMPLEMENTATION_ADDRESS=
# Block the factory was deployed in. Log scans start here.
DEPLOY_BLOCK=
# Key that pays gas to settle funding and relay refunds. Holds only ETH for gas. Never commit it.
RELAYER_PRIVATE_KEY=
# Base mainnet JSON-RPC endpoint.
BASE_RPC_URL=https://mainnet.base.org
# Public origin of this deployment, no trailing slash, e.g. https://ladder.example.com
PUBLIC_URL=

# Optional: an errand to link from the landing and judges pages, and its plan (base64url JSON).
EXAMPLE_ERRAND=
EXAMPLE_PLAN=
# Optional: the GitHub repository URL, for source links and the CI badge.
REPO_URL=
